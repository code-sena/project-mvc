@startuml 12-sequence-create-state
!include style.puml
title Secuencia - Crear departamento
autonumber

actor "Administrador" as U
participant "state-form.jsx\n<<view>>" as V
participant "api/state/route.js\n<<route>>" as R
participant "state-controller.js\n<<controller>>" as C
participant "state-model.js\n<<model>>" as M
database "MySQL" as DB

U -> V : llena el formulario y envía
V -> R : POST /api/state {postalCode, name, description}
R -> C : create(body)
C -> C : validate(data)

alt datos inválidos
  C --> R : error de validación
  R --> V : 400 Bad Request
  V --> U : muestra los errores
else datos válidos
  C -> M : insert(state)
  M -> DB : INSERT
  DB --> M : registro creado
  M --> C : State
  C --> R : State
  R --> V : 201 Created
  V --> U : muestra confirmación
end
@enduml

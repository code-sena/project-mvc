@startuml 12-sequence-create-state
!include style.puml
title Sequence - Create State
autonumber

actor "Administrator" as U
participant "state-form.jsx\n<<view>>" as V
participant "api/state/route.js\n<<route>>" as R
participant "state-controller.js\n<<controller>>" as C
participant "state-model.js\n<<model>>" as M
database "MySQL" as DB

U -> V : fills out form and submits
V -> R : POST /api/state {postalCode, name, description}
R -> C : create(body)
C -> C : validate(data)

alt invalid data
  C --> R : validation error
  R --> V : 400 Bad Request
  V --> U : displays validation errors
else valid data
  C -> M : insert(state)
  M -> DB : INSERT
  DB --> M : record created
  M --> C : State
  C --> R : State
  R --> V : 201 Created
  V --> U : displays confirmation
end
@enduml
